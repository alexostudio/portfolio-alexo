---
import { readdirSync } from 'node:fs';
import { join } from 'node:path';
import { Image } from 'astro:assets';
import { sobre } from '../data/sobre';
import Base from '../layouts/Base.astro';

// CV: si hay un PDF en public/cv/, se ofrece; si no, el botón no existe (nunca un enlace roto).
// Se revisa al compilar: tras añadir o quitar el PDF hay que volver a compilar.
let cv: string | null = null;
try {
	const pdf = readdirSync(join(process.cwd(), 'public', 'cv'))
		.filter((archivo) => archivo.toLowerCase().endsWith('.pdf'))
		.sort()[0];
	if (pdf) cv = `/cv/${encodeURIComponent(pdf)}`;
} catch {
	// La carpeta no existe: no hay CV.
}

const [entrada, ...parrafos] = sobre.bio;
---

<Base
	titulo="Sobre"
	descripcion="ALEXO: fotógrafo y filmmaker en Ciudad de México. Bio, herramientas y clientes."
>
	<article class="seccion contenedor sobre" aria-labelledby="sobre-titulo">
		<div class="titulo-con-barra">
			<h1 id="sobre-titulo" class="titulo-pagina">Sobre ALEXO</h1>
			<span class="barra-alexo" aria-hidden="true"></span>
		</div>

		<div class="presentacion">
			{
				sobre.foto ? (
					<Image
						class="foto"
						src={sobre.foto}
						alt={sobre.altFoto}
						widths={[400, 640, 960]}
						sizes="(min-width: 48rem) 40vw, 100vw"
						loading="eager"
					/>
				) : (
					<div class="foto provisional" style={`background: ${sobre.colorFoto}`} />
				)
			}

			<div class="bio">
				<p class="entrada">{entrada}</p>
				{parrafos.map((parrafo) => <p>{parrafo}</p>)}
				{
					cv && (
						<a href={cv} class="enlace-accion" download>
							Descargar CV (PDF) <span aria-hidden="true">↓</span>
						</a>
					)
				}
			</div>
		</div>

		<div class="listas">
			<section aria-labelledby="herramientas-titulo">
				<h2 id="herramientas-titulo" class="titulo-lista">Herramientas</h2>
				<ul>{sobre.herramientas.map((herramienta) => <li>{herramienta}</li>)}</ul>
			</section>

			<section aria-labelledby="clientes-titulo">
				<h2 id="clientes-titulo" class="titulo-lista">Clientes</h2>
				<ul>{sobre.clientes.map((cliente) => <li>{cliente}</li>)}</ul>
			</section>
		</div>
	</article>
</Base>

<style>
	.sobre {
		display: grid;
		gap: clamp(2.5rem, 1.5rem + 4vw, 5rem);
		padding-top: clamp(2rem, 1rem + 4vw, 4rem);
	}

	.titulo-pagina {
		font-size: var(--texto-hero);
	}

	.presentacion {
		display: grid;
		gap: 2rem;
		align-items: start;
	}

	.foto {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
	}

	.bio {
		display: grid;
		gap: 1.25rem;
		align-content: start;
		justify-items: start;
	}

	.bio p {
		max-width: 60ch;
		color: var(--color-texto-suave);
	}

	.bio .entrada {
		max-width: 32ch;
		font-family: var(--fuente-titulos);
		font-size: var(--texto-tarjeta);
		line-height: 1.3;
		color: var(--color-texto);
	}

	.listas {
		display: grid;
		gap: 2.5rem;
	}

	.titulo-lista {
		margin-bottom: 1rem;
		font-size: var(--texto-tarjeta);
	}

	ul {
		display: grid;
		gap: 0.5rem;
		padding: 0;
		list-style: none;
		color: var(--color-texto-suave);
	}

	@media (min-width: 48rem) {
		.presentacion {
			grid-template-columns: 2fr 3fr;
			gap: clamp(2rem, 1rem + 3vw, 4rem);
		}

		.listas {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
