---
import { Image } from 'astro:assets';
import { exploraciones } from '../data/exploraciones';
---

<section class="seccion contenedor" aria-labelledby="exploraciones-titulo">
	<!-- Marco con degradado: excepción aprobada en references/marca.md -->
	<div class="marco">
		<div class="interior">
			<div class="titulo-con-barra">
				<h2 id="exploraciones-titulo" class="titulo-seccion">Exploraciones</h2>
				<span class="barra-alexo" aria-hidden="true"></span>
			</div>

			<ul class="rejilla">
				{
					exploraciones.map((exploracion) => (
						<li>
							<article class="tarjeta">
								<div class="marco-foto">
									{exploracion.imagen ? (
										<Image
											src={exploracion.imagen.src}
											alt={exploracion.imagen.alt}
											widths={[400, 640, 800]}
											sizes="(min-width: 64rem) 28vw, (min-width: 48rem) 45vw, 100vw"
										/>
									) : (
										<div class="provisional" style={`background: ${exploracion.color}`} />
									)}
								</div>
								<h3>{exploracion.titulo}</h3>
								<p>{exploracion.texto}</p>
								{exploracion.enlace ? (
									<a href={exploracion.enlace} class="leer-mas">
										Leer más<span class="solo-lector"> sobre {exploracion.titulo}</span>
										<span aria-hidden="true">&nbsp;→</span>
									</a>
								) : (
									<span class="leer-mas sin-enlace">Leer más&nbsp;<span aria-hidden="true">→</span></span>
								)}
							</article>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	/* El degradado es el fondo; el interior negro deja ver solo 2 px como marco */
	.marco {
		padding: 2px;
		background: var(--gradiente-exploraciones);
	}

	.interior {
		display: grid;
		gap: 2.5rem;
		padding: clamp(1.5rem, 0.5rem + 4vw, 4rem);
		background: var(--color-fondo);
	}

	.rejilla {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
		gap: 2.5rem 1.5rem;
		padding: 0;
		list-style: none;
	}

	.tarjeta {
		display: grid;
		gap: 0.75rem;
		align-content: start;
	}

	.marco-foto {
		aspect-ratio: 4 / 3;
		overflow: hidden;
	}

	.marco-foto :global(img),
	.provisional {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	h3 {
		margin-top: 0.5rem;
		font-size: var(--texto-tarjeta);
	}

	p {
		color: var(--color-texto-suave);
	}

	.leer-mas {
		display: inline-flex;
		align-items: center;
		min-height: var(--objetivo-tactil);
		font-weight: 600;
		text-decoration: none;
	}

	a.leer-mas:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	/* Sin destino todavía: se ve, pero no se puede enfocar ni pulsar */
	.sin-enlace {
		color: var(--color-texto-tenue);
	}
</style>
