---
import RejillaCategorias from './RejillaCategorias.astro';
---

<section id="proyectos" class="seccion contenedor proyectos" aria-labelledby="proyectos-titulo">
	<div class="titulo-con-barra">
		<h2 id="proyectos-titulo" class="titulo-seccion">Proyectos recientes</h2>
		<span class="barra-alexo" aria-hidden="true"></span>
	</div>

	<RejillaCategorias nivel="h3" />
</section>

<style>
	.proyectos {
		display: grid;
		gap: 2.5rem;
	}
</style>
