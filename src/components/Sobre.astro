---
// Los dos primeros párrafos de la bio (aprobados por ALEXO), desde src/data/sobre.ts.
import { sobre } from '../data/sobre';

const [entrada, presentacion] = sobre.bio;
---

<section id="sobre" class="seccion contenedor sobre" aria-labelledby="sobre-titulo">
	<div class="titulo-con-barra">
		<h2 id="sobre-titulo" class="titulo-seccion">Sobre ALEXO</h2>
		<span class="barra-alexo" aria-hidden="true"></span>
	</div>
	<p class="entrada">{entrada}</p>
	<p>{presentacion}</p>
	<a href="/sobre/" class="enlace-accion">Conocer más <span aria-hidden="true">→</span></a>
</section>

<style>
	.sobre {
		display: grid;
		justify-items: center;
		gap: 1.5rem;
		text-align: center;
	}

	p {
		max-width: 60ch;
		color: var(--color-texto-suave);
	}

	.entrada {
		max-width: 32ch;
		font-family: var(--fuente-titulos);
		font-size: var(--texto-tarjeta);
		line-height: 1.3;
		color: var(--color-texto);
	}
</style>
