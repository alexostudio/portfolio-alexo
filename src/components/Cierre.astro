---
import { url } from '../utils/url';
// Llamada final de la portada (6.8, documento de ajustes punto 8). Los datos de contacto
// siguen en el pie.
import { enlaceWhatsApp } from '../config/sitio';
---

<section class="seccion contenedor cierre" aria-labelledby="cierre-titulo">
	<!-- Acento corto encima: no depende de dónde se parta el titular en cada pantalla -->
	<span class="barra-alexo barra-gruesa" aria-hidden="true"></span>
	<h2 id="cierre-titulo">¿Tienes un proyecto<br /> en mente?</h2>
	<p class="subtitulo">Transformemos tu idea en imágenes que comuniquen, conecten y destaquen.</p>
	<div class="acciones">
		<a href={enlaceWhatsApp} class="boton" target="_blank" rel="noopener noreferrer">
			Hablemos de tu proyecto<span class="solo-lector"> (WhatsApp, se abre en otra pestaña)</span>
		</a>
		<a href={url('/proyectos/')} class="enlace-accion">Explorar proyectos <span aria-hidden="true">→</span></a>
	</div>
</section>

<style>
	.cierre {
		display: grid;
		justify-items: start;
		gap: 1.5rem;
	}

	.barra-gruesa {
		height: calc(var(--alto-barra) * 1.5);
	}

	h2 {
		font-size: var(--texto-cierre);
		line-height: 1;
		letter-spacing: -0.01em;
	}

	.subtitulo {
		max-width: 36ch;
		font-family: var(--fuente-titulos);
		font-size: var(--texto-tarjeta);
		line-height: 1.3;
		color: var(--color-texto-suave);
	}

	.acciones {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 2rem;
		margin-top: 0.5rem;
	}
</style>
