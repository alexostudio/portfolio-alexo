---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { COLORES } from '../data/provisional';

// Fotos de references/estructura.md, sección 3. Cuando lleguen:
//   import claqueta from '../assets/detras/claqueta-script.jpg';
// y sustituir `imagen: null` por `imagen: claqueta`. El recorte 3:4 debe aprobarlo ALEXO.
interface Toma {
	imagen: ImageMetadata | null;
	alt: string;
	/** Qué foto va aquí (claqueta y script, equipo de rodaje, línea de tiempo de edición). */
	contenido: string;
	/** Color provisional mientras falte la foto. */
	color: string;
}

const tomas: Toma[] = [
	{ imagen: null, alt: '', contenido: 'claqueta y script', color: COLORES.purpura },
	{ imagen: null, alt: '', contenido: 'equipo de rodaje', color: COLORES.ocre },
	{ imagen: null, alt: '', contenido: 'línea de tiempo de edición', color: COLORES.azul },
];
---

<section class="seccion contenedor detras" aria-labelledby="detras-titulo">
	<div class="titulo-con-barra">
		<h2 id="detras-titulo" class="titulo-seccion">Detrás de cámara</h2>
		<span class="barra-alexo" aria-hidden="true"></span>
	</div>

	<ul class="escalera">
		{
			tomas.map((toma) => (
				<li class="toma">
					{toma.imagen ? (
						<Image
							src={toma.imagen}
							alt={toma.alt}
							widths={[320, 480, 640, 960]}
							sizes="(min-width: 64rem) 26rem, 40vw"
						/>
					) : (
						<div class="provisional" style={`background: ${toma.color}`} data-contenido={toma.contenido} />
					)}
				</li>
			))
		}
	</ul>
</section>

<style>
	.detras {
		display: grid;
		gap: 2.5rem;
	}

	/*
	 * Escalera en porcentajes: se mantiene igual a cualquier ancho, solo cambia la escala.
	 * Toma: 40 % del ancho, 3:4 → alto = 53.3 % del ancho. Contenedor 16:11 → alto = 68.75 %.
	 * La última empieza en (68.75 − 53.3) / 68.75 ≈ 22.4 % para acabar en el borde inferior.
	 */
	.escalera {
		position: relative;
		width: 100%;
		max-width: 64rem;
		margin-inline: auto;
		aspect-ratio: 16 / 11;
		padding: 0;
		list-style: none;
	}

	.toma {
		position: absolute;
		width: 40%;
		aspect-ratio: 3 / 4;
		box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.6);
	}

	.toma:nth-child(1) {
		left: 0;
		top: 0;
		z-index: 1;
	}

	.toma:nth-child(2) {
		left: 30%;
		top: 11.2%;
		z-index: 2;
	}

	.toma:nth-child(3) {
		left: 60%;
		top: 22.4%;
		z-index: 3;
	}

	.toma :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Color provisional (src/data/provisional.ts) mientras falte la foto */
	.provisional {
		height: 100%;
	}
</style>
