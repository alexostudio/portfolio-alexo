---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

// Fotos de references/estructura.md, sección 3. Cuando lleguen:
//   import claqueta from '../assets/detras/claqueta-script.jpg';
// y sustituir `imagen: null` por `imagen: claqueta`. El recorte 3:4 debe aprobarlo ALEXO.
interface Toma {
	imagen: ImageMetadata | null;
	alt: string;
	pendiente: string;
}

const tomas: Toma[] = [
	{ imagen: null, alt: '', pendiente: 'claqueta y script' },
	{ imagen: null, alt: '', pendiente: 'equipo de rodaje' },
	{ imagen: null, alt: '', pendiente: 'línea de tiempo de edición' },
];
---

<section class="seccion contenedor detras" aria-labelledby="detras-titulo">
	<div class="cabecera">
		<h2 id="detras-titulo" class="titulo-seccion">Detrás de cámara</h2>
		<span class="barra-alexo" aria-hidden="true"></span>
	</div>

	<ul class="escalera">
		{
			tomas.map((toma) => (
				<li class="toma">
					{toma.imagen ? (
						<Image
							src={toma.imagen}
							alt={toma.alt}
							widths={[320, 480, 640, 960]}
							sizes="(min-width: 64rem) 26rem, 40vw"
						/>
					) : (
						<div class="provisional">
							<span>[PENDIENTE: foto de {toma.pendiente}]</span>
						</div>
					)}
				</li>
			))
		}
	</ul>
</section>

<style>
	.detras {
		display: grid;
		gap: 2.5rem;
	}

	.cabecera {
		display: grid;
		gap: 1rem;
	}

	/*
	 * Escalera en porcentajes: se mantiene igual a cualquier ancho, solo cambia la escala.
	 * Toma: 40 % del ancho, 3:4 → alto = 53.3 % del ancho. Contenedor 16:11 → alto = 68.75 %.
	 * La última empieza en (68.75 − 53.3) / 68.75 ≈ 22.4 % para acabar en el borde inferior.
	 */
	.escalera {
		position: relative;
		width: 100%;
		max-width: 64rem;
		margin-inline: auto;
		aspect-ratio: 16 / 11;
		padding: 0;
		list-style: none;
	}

	.toma {
		position: absolute;
		width: 40%;
		aspect-ratio: 3 / 4;
		box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.6);
	}

	.toma:nth-child(1) {
		left: 0;
		top: 0;
		z-index: 1;
	}

	.toma:nth-child(2) {
		left: 30%;
		top: 11.2%;
		z-index: 2;
	}

	.toma:nth-child(3) {
		left: 60%;
		top: 22.4%;
		z-index: 3;
	}

	.toma :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Texto arriba a la izquierda: la toma siguiente tapa el 25 % derecho de cada recuadro */
	.provisional {
		display: grid;
		place-items: start;
		height: 100%;
		padding: 0.75rem;
		background: var(--color-superficie);
		border: 1px solid var(--color-linea);
		font-size: clamp(0.6875rem, 0.6rem + 0.4vw, 0.875rem);
		color: var(--color-texto-tenue);
	}

	.provisional span {
		max-width: 70%;
	}
</style>
