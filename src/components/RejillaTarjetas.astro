---
// Rejilla de tarjetas con foto (categorías en la portada y /proyectos; proyectos en cada categoría).
import { Image } from 'astro:assets';
import type { Foto } from '../data/categorias';

export interface Tarjeta {
	titulo: string;
	descripcion: string;
	href: string;
	/** null = se pinta `color` (contenido provisional). */
	portada: Foto | null;
	color: string;
}

interface Props {
	tarjetas: Tarjeta[];
	/** Nivel del título de cada tarjeta, para respetar la jerarquía de la página. */
	nivel?: 'h2' | 'h3';
}

const { tarjetas, nivel: Titulo = 'h3' } = Astro.props;
---

<ul class="rejilla">
	{
		tarjetas.map((tarjeta) => (
			<li>
				<a class="tarjeta" href={tarjeta.href}>
					<div class="marco-foto">
						{tarjeta.portada ? (
							<Image
								src={tarjeta.portada.imagen}
								alt={tarjeta.portada.alt}
								widths={[400, 640, 800, 1200, 1600]}
								sizes="(min-width: 48rem) calc(50vw - 4rem), 100vw"
							/>
						) : (
							<div class="provisional" style={`background: ${tarjeta.color}`} />
						)}
					</div>
					<Titulo class="titulo">{tarjeta.titulo}</Titulo>
					<p>{tarjeta.descripcion}</p>
				</a>
			</li>
		))
	}
</ul>

<style>
	.rejilla {
		display: grid;
		gap: 2.5rem 1.5rem;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 48rem) {
		.rejilla {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	.tarjeta {
		display: grid;
		gap: 0.75rem;
		text-decoration: none;
	}

	/* Encuadre 3:2 aprobado el 2026-11-19 */
	.marco-foto {
		aspect-ratio: 3 / 2;
		overflow: hidden;
		background: var(--color-superficie);
	}

	.marco-foto :global(img),
	.provisional {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	/* Zoom suave al pasar el ratón o al enfocar con teclado; el marco recorta lo que sobra */
	@media (prefers-reduced-motion: no-preference) {
		.tarjeta:hover :is(.marco-foto :global(img), .provisional),
		.tarjeta:focus-visible :is(.marco-foto :global(img), .provisional) {
			transform: scale(1.05);
		}
	}

	.titulo {
		margin-top: 0.5rem;
		font-size: var(--texto-tarjeta);
	}

	.tarjeta:hover .titulo {
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 6px;
	}

	p {
		max-width: 60ch;
		color: var(--color-texto-suave);
	}
</style>
