---
import { getImage, Image } from 'astro:assets';
import type { Foto } from '../data/categorias';

interface Props {
	fotos: Foto[];
}

const { fotos } = Astro.props;

// Versión grande para el visor (y destino del enlace si no hay JavaScript).
const elementos = await Promise.all(
	fotos.map(async (foto) => ({
		...foto,
		grande: await getImage({
			src: foto.imagen,
			width: Math.min(2048, foto.imagen.width),
			format: 'webp',
		}),
	})),
);
---

<ul class="galeria" data-galeria>
	{
		elementos.map((foto, i) => (
			<li>
				<a href={foto.grande.src} class="miniatura" data-indice={i} data-alt={foto.alt}>
					<Image
						src={foto.imagen}
						alt={foto.alt}
						widths={[400, 640, 960, 1280]}
						sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 100vw"
					/>
				</a>
			</li>
		))
	}
</ul>

<dialog class="visor" aria-label="Foto ampliada" data-visor>
	<figure>
		<img src="" alt="" data-visor-img />
	</figure>
	<p class="contador" aria-live="polite" data-visor-contador></p>
	<button type="button" class="control cerrar" aria-label="Cerrar" data-visor-cerrar>✕</button>
	<button type="button" class="control anterior" aria-label="Foto anterior" data-visor-anterior
		>←</button
	>
	<button type="button" class="control siguiente" aria-label="Foto siguiente" data-visor-siguiente
		>→</button
	>
</dialog>

<style>
	/* Muro de fotos: cada una con su proporción original, sin recortar */
	.galeria {
		columns: 3 18rem;
		column-gap: 1rem;
		padding: 0;
		list-style: none;
	}

	.galeria li {
		break-inside: avoid;
		margin-bottom: 1rem;
	}

	.miniatura {
		display: block;
		overflow: hidden;
		cursor: zoom-in;
	}

	.miniatura :global(img) {
		width: 100%;
		transition: transform 0.5s ease;
	}

	@media (prefers-reduced-motion: no-preference) {
		.miniatura:hover :global(img),
		.miniatura:focus-visible :global(img) {
			transform: scale(1.03);
		}
	}

	/* Visor */
	.visor {
		width: 100vw;
		max-width: 100vw;
		height: 100dvh;
		max-height: 100dvh;
		padding: 0;
		border: 0;
		background: rgb(0 0 0 / 0.94);
		color: var(--color-texto);
	}

	.visor::backdrop {
		background: rgb(0 0 0 / 0.6);
	}

	figure {
		display: grid;
		place-items: center;
		height: 100%;
		padding: 4rem 1rem;
	}

	figure img {
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		object-fit: contain;
	}

	.contador {
		position: absolute;
		top: 1rem;
		left: 1rem;
		font-size: var(--texto-pequeno);
		color: var(--color-texto-tenue);
	}

	.control {
		position: absolute;
		display: grid;
		place-items: center;
		width: var(--objetivo-tactil);
		height: var(--objetivo-tactil);
		border: 1px solid rgb(255 255 255 / 0.4);
		border-radius: 50%;
		background: rgb(0 0 0 / 0.5);
		font-size: 1.25rem;
		cursor: pointer;
	}

	.control:hover {
		border-color: var(--color-texto);
	}

	.cerrar {
		top: 0.75rem;
		right: 0.75rem;
	}

	.anterior,
	.siguiente {
		top: 50%;
		transform: translateY(-50%);
	}

	.anterior {
		left: 0.75rem;
	}

	.siguiente {
		right: 0.75rem;
	}

	/* En pantallas angostas, las flechas abajo para no tapar la foto */
	@media (max-width: 40rem) {
		.anterior,
		.siguiente {
			top: auto;
			bottom: 1rem;
			transform: none;
		}

		.anterior {
			left: calc(50% - 3.5rem);
		}

		.siguiente {
			right: calc(50% - 3.5rem);
		}
	}
</style>

<script>
	const galeria = document.querySelector<HTMLElement>('[data-galeria]');
	const visor = document.querySelector<HTMLDialogElement>('[data-visor]');

	if (galeria && visor && typeof visor.showModal === 'function') {
		const enlaces = [...galeria.querySelectorAll<HTMLAnchorElement>('a[data-indice]')];
		const img = visor.querySelector<HTMLImageElement>('[data-visor-img]')!;
		const contador = visor.querySelector<HTMLElement>('[data-visor-contador]')!;
		let actual = 0;

		const mostrar = (indice: number) => {
			actual = (indice + enlaces.length) % enlaces.length;
			const enlace = enlaces[actual];
			img.src = enlace.href;
			img.alt = enlace.dataset.alt ?? '';
			contador.textContent = `${actual + 1} / ${enlaces.length}`;
		};

		enlaces.forEach((enlace, i) =>
			enlace.addEventListener('click', (evento) => {
				evento.preventDefault();
				mostrar(i);
				visor.showModal();
			}),
		);

		visor.querySelector('[data-visor-cerrar]')!.addEventListener('click', () => visor.close());
		visor.querySelector('[data-visor-anterior]')!.addEventListener('click', () => mostrar(actual - 1));
		visor.querySelector('[data-visor-siguiente]')!.addEventListener('click', () => mostrar(actual + 1));

		visor.addEventListener('keydown', (evento) => {
			if (evento.key === 'ArrowLeft') mostrar(actual - 1);
			if (evento.key === 'ArrowRight') mostrar(actual + 1);
		});

		// Clic fuera de la foto (en el fondo del visor) cierra
		visor.addEventListener('click', (evento) => {
			const objetivo = evento.target as HTMLElement;
			if (objetivo === visor || objetivo.tagName === 'FIGURE') visor.close();
		});

		// Al cerrar, devolver el foco a la miniatura de la foto que se estaba viendo
		visor.addEventListener('close', () => enlaces[actual].focus());

		if (enlaces.length < 2) {
			visor.querySelectorAll<HTMLElement>('.anterior, .siguiente').forEach((b) => (b.hidden = true));
		}
	}
</script>
